{
	"name": "cmd-statusline",
	"version": "1.0.0",
	"description": "Command Code status bar mod — cwd, branch, session name, model, effort, and usage metrics with color coding.",
	"license": "MIT",
	"type": "module",
	"commandcode": {
		"mods": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"lib.ts",
		"render.ts",
		"usage.ts",
		"README.md",
		"LICENSE",
		"statusline.png"
	],
	"scripts": {
		"test": "vitest run",
		"test:unit": "vitest run --coverage",
		"test:e2e": "node e2e/sync-models.mjs && node e2e/sync-plans.mjs && npm run build:e2e && playwright test",
		"build:e2e": "esbuild lib.ts --bundle --format=esm --outfile=e2e/lib.browser.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.5.0",
		"@vitest/coverage-v8": "^3.2.7",
		"esbuild": "^0.25.0",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.69.0",
		"vitest": "^3.2.7"
	}
}
